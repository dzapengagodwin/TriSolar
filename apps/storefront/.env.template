# Storefront Environment Variables

# Medusa Backend & Region
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_DEFAULT_REGION=zw
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# TRITECH project quotation destination (set this to your monitored business inbox)
NEXT_PUBLIC_QUOTE_EMAIL=

# Google Analytics 4 (Measurement ID)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cache Revalidation Secret (server-side only, never prefix with NEXT_PUBLIC_)
REVALIDATION_SECRET=your_secure_random_secret_here

# Optional Services
NEXT_PUBLIC_STRIPE_KEY=
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
# Note: SendGrid (SENDGRID_API_KEY, SENDGRID_WEBSITE_LIST_ID) is managed
# exclusively on the Medusa backend in apps/backend/.env
